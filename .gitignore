# pytest 缓存与临时目录（2026-10-04 补）
.pytest_cache/
backend/.pytest_cache/
# 【注意】不要在这里写 .pytest_cache/v/cache/ —— 那会连带忽略 pytest 的 .gitignore 与 CACHEDIR.TAG
.pytest_tmp/
.pytest_tmp*/
# pytest 的 basetemp 会在「工作区根」重建此目录（实测每次跑全量都会出现）
pytest-of-*/
pytest-of-*
# 测试基线与权限诊断产物（本地留档用，不进版本库）
team/pytest-baseline.txt
team/acl-reports/

# Obsidian（若启用）
.obsidian/

# 临时提交消息文件（本仓库用消息文件写中文 commit，勿入库）
.commit-msg*.tmp
commit-msg.tmp